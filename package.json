{
  "name": "cohesion-design-system-preview",
  "version": "2.0.0",
  "private": true,
  "description": "COHESION design system static preview and copy package",
  "packageManager": "pnpm@11.6.0",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": "11.6.0"
  },
  "scripts": {
    "build": "node scripts/build-preview.mjs",
