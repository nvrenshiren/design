    "tw-animate-css": "1.4.0"
  },
  "dependencies": {
    "@ant-design/icons": "6.3.4",
    "animejs": "4.5.0",
    "antd": "6.6.6",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.0",
    "lucide-react": "1.59.0",
    "radix-ui": "1.8.1",
    "react": "18.3.1",
